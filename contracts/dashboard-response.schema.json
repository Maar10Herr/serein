{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serein:contracts:dashboard-response.schema.json",
  "title": "Dashboard research presentation",
  "description": "Response to the native dashboard operation. Status fields are inherited from status and may be extended; research presentation fields are closed below.",
  "type": "object",
  "properties": {
    "cards": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/Card" }
    },
    "memories": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/Memory" }
    },
    "topics": { "type": "array" },
    "model_available": { "type": "boolean" },
    "index_mode": { "type": "string", "enum": ["hybrid", "lexical"] }
  },
  "required": ["cards", "memories", "topics"],
  "$defs": {
    "Correction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["not_about_me", "wrong_topic", "temporary_research", "confirm_constraint", "do_not_use"]
        },
        "text": { "type": ["string", "null"] }
      },
      "required": ["action", "text"],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "site": { "type": "string" },
        "text": { "type": "string" },
        "state": { "type": "string", "enum": ["observed", "confirmed"] },
        "last_seen": { "type": "string", "format": "date-time" },
        "sessions": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "enum": ["visit", "search"] },
        "prominent": { "type": "boolean" },
        "corrections": { "type": "array", "items": { "$ref": "#/$defs/Correction" } }
      },
      "required": ["id", "site", "text", "state", "last_seen", "sessions", "sites", "kind", "prominent", "corrections"],
      "additionalProperties": false
    },
    "Memory": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "label": { "type": "string" },
        "last_seen": { "type": "string", "format": "date-time" },
        "sessions": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "minimum": 0 },
        "evidence_count": { "type": "integer", "minimum": 2 },
        "items": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/Card" } }
      },
      "required": ["id", "label", "last_seen", "sessions", "sites", "evidence_count", "items"],
      "additionalProperties": false
    }
  }
}
